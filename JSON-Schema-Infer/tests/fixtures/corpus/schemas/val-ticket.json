{
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "reporter": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^[a-z]{3,8}$"
        },
        "emailAddress": {
          "type": "string",
          "format": "email"
        }
      },
      "required": [
        "handle"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "maxItems": 3
    },
    "closed": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "closed": {
        "const": true
      }
    },
    "required": [
      "closed"
    ]
  },
  "then": {
    "required": [
      "priority"
    ]
  },
  "required": [
    "ticket_id",
    "title"
  ],
  "additionalProperties": true
}
