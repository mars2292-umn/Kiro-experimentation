{
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ORD-[0-9]{6}$"
    },
    "status": {
      "enum": [
        "new",
        "paid",
        "shipped",
        "cancelled"
      ]
    },
    "placedAt": {
      "type": "string",
      "format": "date-time"
    },
    "customer": {
      "$ref": "#/$defs/customer"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000.0
    }
  },
  "$defs": {
    "customer": {
      "type": "object",
      "properties": {
        "email_address": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string",
          "maxLength": 12
        }
      },
      "required": [
        "email_address"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]{3}$"
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "unit_price": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        }
      },
      "required": [
        "sku",
        "qty"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "orderId",
    "status",
    "lines"
  ],
  "additionalProperties": false
}
