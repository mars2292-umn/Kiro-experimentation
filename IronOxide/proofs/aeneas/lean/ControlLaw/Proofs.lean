/-
  Proofs over the Aeneas translation of `proofs/aeneas/controllaw`
  (task 17.3, R46.1): the fixed-point PI step returns `ok` for every input
  satisfying the state invariant (no panic, no arithmetic overflow, every
  cast in bounds), its output is saturated, and the invariant is preserved.
  `ControlLaw/Controllaw.lean` is generated by Aeneas and committed; this
  file is handwritten.
-/
import Aeneas
import ControlLaw.Controllaw
open Aeneas Aeneas.Std Result

namespace controllaw

/- The constants. `KP` and `KI` are plain scalars; the bounds are shifts,
   so they are `Result`s whose values the proofs need. -/

@[simp] theorem KP_val : KP.val = 16384 := by unfold KP; rfl
@[simp] theorem KI_val : KI.val = 1638 := by unfold KI; rfl

theorem ERR_MAX_eq : ERR_MAX = ok 65536#i32 := by unfold ERR_MAX; rfl
theorem INT_MAX_eq : INT_MAX = ok 4194304#i32 := by unfold INT_MAX; rfl
theorem OUT_MAX_eq : OUT_MAX = ok 131072#i32 := by unfold OUT_MAX; rfl

@[step] theorem ERR_MAX_spec : ERR_MAX ⦃ r => r.val = 65536 ⦄ := by
  rw [ERR_MAX_eq]; simp

@[step] theorem INT_MAX_spec : INT_MAX ⦃ r => r.val = 4194304 ⦄ := by
  rw [INT_MAX_eq]; simp

@[step] theorem OUT_MAX_spec : OUT_MAX ⦃ r => r.val = 131072 ⦄ := by
  rw [OUT_MAX_eq]; simp

/-- `clamp` never fails and returns a value within `[lo, hi]` whenever
`lo ≤ hi`; a value already within the bounds is returned unchanged. -/
@[step] theorem clamp_spec (x lo hi : I32) (h : lo.val ≤ hi.val) :
  clamp x lo hi ⦃ r => lo.val ≤ r.val ∧ r.val ≤ hi.val ∧
    (lo.val ≤ x.val → x.val ≤ hi.val → r.val = x.val) ⦄ := by
  unfold clamp
  split
  · simp; scalar_tac
  · split
    · simp; scalar_tac
    · simp; scalar_tac

/-- The state invariant: the integral within its anti-windup clamp. -/
def PiState.inv (s : PiState) : Prop := -4194304 ≤ s.integral.val ∧ s.integral.val ≤ 4194304

/-- The initial state satisfies the invariant. -/
theorem PiState.new_spec : PiState.new ⦃ s => s.inv ⦄ := by
  unfold PiState.new PiState.inv; simp

/-- `pi_step` on a state satisfying the invariant and any error returns
`ok` (absence of panics and overflow, every cast in bounds), an output
within `[-OUT_MAX, OUT_MAX]`, and a state satisfying the invariant. -/
theorem pi_step_spec (state : PiState) (error : I32) (h : state.inv) :
  pi_step state error ⦃ out s' =>
    -131072 ≤ out.val ∧ out.val ≤ 131072 ∧ s'.inv ⦄ := by
  unfold PiState.inv at *
  unfold pi_step
  have hKP : KP.val = 16384 := KP_val
  have hKI : KI.val = 1638 := KI_val
  -- The clamped error: |e| ≤ 2^16.
  step as ⟨ emax, hemax ⟩
  step as ⟨ eneg, heneg ⟩
  step as ⟨ e, he0, he1, _ ⟩
  -- The integral: the sum does not overflow (|integral| ≤ 2^22, |e| ≤ 2^16)
  -- and the clamp keeps it within the anti-windup bound.
  step as ⟨ sum, hsum ⟩
  step as ⟨ imax, himax ⟩
  step as ⟨ ineg, hineg ⟩
  step as ⟨ integral, hint0, hint1, _ ⟩
  -- The proportional term: KP * e ≤ 2^30 fits an i32; the shift is a
  -- division by 2^15, so |p| ≤ 2^15.
  step as ⟨ kpe, hkpe ⟩
  step as ⟨ p, hp, _ ⟩
  simp only [Int.shiftRight_eq_div_pow, Nat.reducePow] at hp
  -- The integral term in i64: both casts widen, the product
  -- 1638 * 2^22 fits, the shifted value fits an i32 again.
  step with IScalar.cast_inBounds_spec as ⟨ ki64, hki64 ⟩
  step with IScalar.cast_inBounds_spec as ⟨ int64, hint64 ⟩
  have hk : ki64.val = 1638 := by scalar_tac
  step as ⟨ prod, hprod ⟩
  rw [hk] at hprod
  step as ⟨ shifted, hsh, _ ⟩
  simp only [Int.shiftRight_eq_div_pow, Nat.reducePow] at hsh
  have hb : IScalar.min IScalarTy.I32 ≤ shifted.val ∧ shifted.val ≤ IScalar.max IScalarTy.I32 := by
    simp only [IScalar.min, IScalar.max, IScalarTy.numBits]; norm_num; push_cast at *; omega
  step with IScalar.cast_inBounds_spec IScalarTy.I32 shifted hb as ⟨ i32, hi32 ⟩
  -- The sum of the terms and the output saturation.
  step as ⟨ sumpi, hsumpi ⟩
  step as ⟨ omax, homax ⟩
  step as ⟨ oneg, honeg ⟩
  step as ⟨ out, hout0, hout1, _ ⟩
  scalar_tac

end controllaw
