                                                  let i44 ←
                                                    lift (i42 ||| i43)
                                                  let i45 ← imm6 <<< 12#i32
                                                  let i46 ←
                                                    lift (i44 ||| i45)
                                                  let i47 ← imm11 <<< 1#i32
                                                  let raw ←
                                                    lift (i46 ||| i47)
                                                  let imm ←
                                                    thumb.sign_extend raw
                                                      21#u32
                                                  let i48 ←
                                                    lift (UScalar.hcast .I32
                                                      pc)
                                                  let i49 ← i48 + 4#i32
                                                  let i50 ← i49 + imm
                                                  let i51 ←
                                                    lift (IScalar.hcast .U32
                                                      i50)
                                                  ok (thumb.Decoded.Is
                                                    (thumb.Effect.Branch i51))
                                              else
                                                ok (thumb.Decoded.Is
                                                  thumb.Effect.Other)

end rsk_link
