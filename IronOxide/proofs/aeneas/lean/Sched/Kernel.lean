def arch.bound.Bound.Insts.Rsk_kernelArchBoundKernelOps.intake
  {NT : Std.Usize} {NR : Std.Usize} {NP : Std.Usize} {NL : Std.Usize} {NS :
  Std.Usize} {NE : Std.Usize} (self : arch.bound.Bound NT NR NP NL NS NE)
  (t : Std.U8) (source_partition : Std.U8) (now : Std.U64) (offender : Std.U8)
  :
  Result (arch.bound.Bound NT NR NP NL NS NE)
  := do
  let i ← lift (UScalar.cast .Usize t)
  if i < NT
  then
    let i1 ← lift (UScalar.cast .Usize source_partition)
    if i1 < NP
    then
      let i2 ← lift (UScalar.cast .Usize t)
      let tc ← Array.index_usize self.cfg.tasks i2
      if tc.kind = rsk_logic.logic.KIND_SPORADIC
      then
        if now <= self.cfg.operating_duration
        then
          let i3 ← lift (UScalar.cast .Usize offender)
          let offender1 ← if i3 < NT
                            then ok offender
                            else ok t
          let k ←
            rsk_logic.logic.kernel.Kernel.intake self.kernel self.cfg t
              source_partition now offender1
          ok { self with kernel := k }
        else ok self
      else ok self
    else ok self
  else ok self

