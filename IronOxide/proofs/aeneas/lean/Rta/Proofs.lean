/-
  Proofs over the Aeneas translation of the Analyzer's response-time fixed
  point (`crates/rsk-analyzer/src/rta.rs`; Verification_Plan 7.2,
  2026-11-14). `Rta/Rta.lean` is generated by Aeneas from the crate as
  rustc compiles it without Verus, the ghost code erased, and committed;
  this file is handwritten.

  The Verus proof of `rta::fixpoint` is about the source under Verus's
  reading of it. Here the same three functions, as Charon extracts them
  from the compiler's MIR and Aeneas renders them as Lean functions, are
  proven against the recurrence stated again in Lean:

  - `ceil_div_exec_spec`, `interference_exec_spec`: when they return a
    value it is `⌈a / t⌉` and the interference sum; they return (no panic,
    no out-of-bounds index, no arithmetic overflow, and the recursion ends).
  - `fixpoint_spec`: for every Task set whose periods are positive,
    `fixpoint` returns, and `Fixpoint w` is the least fixed point of
    `w = base + Σ ⌈(w + J_j) / T_j⌉ · E_j` with `jitter + w ≤ deadline`;
    `NotSchedulable w` has `jitter + w > deadline` and `w` at most every
    fixed point; `Overflow` claims nothing.

  The definitions `ceilDiv`, `interf`, `stepF` restate `rta.rs`'s
  `ceil_div`, `interference`, `step` over the naturals (the values are
  `u64`); that the two statements are the same is by reading them.
-/
import Aeneas
import Rta.Rta
open Aeneas Aeneas.Std Result

namespace rsk_analyzer

def ceilDiv (a t : Nat) : Nat := (a + (t - 1)) / t

def interf : List rta.Term → Nat → Nat
  | [], _ => 0
  | t :: ts, w => ceilDiv (w + t.jitter.val) t.period.val * t.bound.val + interf ts w

def stepF (base : Nat) (ts : List rta.Term) (w : Nat) : Nat := base + interf ts w

def termsOk (ts : List rta.Term) : Prop := ∀ t ∈ ts, 0 < t.period.val

theorem ceilDiv_mono (a b t : Nat) (h : a ≤ b) : ceilDiv a t ≤ ceilDiv b t := by
  unfold ceilDiv
  exact Nat.div_le_div_right (by omega)

theorem interf_mono (ts : List rta.Term) (w1 w2 : Nat) (h : w1 ≤ w2) :
    interf ts w1 ≤ interf ts w2 := by
  induction ts with
  | nil => simp [interf]
  | cons t ts ih =>
    simp only [interf]
    exact Nat.add_le_add (Nat.mul_le_mul_right _ (ceilDiv_mono _ _ _ (by omega))) ih

theorem MAX_val : (core.num.U64.MAX).val = 18446744073709551615 := by rfl
theorem rMax_val : U64.rMax = 18446744073709551615 := by rfl
theorem max_val : U64.max = 18446744073709551615 := by scalar_tac

/-- `scalar_tac` with the value of `u64::MAX` in its three spellings. -/
macro "sc" : tactic =>
  `(tactic| (try simp only [MAX_val, rMax_val, max_val] at *) <;> scalar_tac)

theorem ceil_div_exec_spec (a t : U64) (h : 0 < t.val) :
    rta.ceil_div_exec a t ⦃ r => ∀ v, r = some v → v.val = ceilDiv a.val t.val ⦄ := by
  unfold rta.ceil_div_exec
  step as ⟨ i, hi ⟩
  step as ⟨ i1, hi1 ⟩
  · sc
  split
  · simp
  · step as ⟨ i2, hi2 ⟩
    · sc
    step as ⟨ i3, hi3 ⟩
    intro v hv
    simp at hv
    subst hv
    simp [ceilDiv, hi3, hi2, hi]

theorem interference_exec_spec (terms : alloc.vec.Vec rta.Term) (from' : Usize) (w : U64)
    (hok : termsOk terms.val) (hfrom : from'.val ≤ terms.length) :
    rta.interference_exec terms from' w
      ⦃ r => ∀ v, r = some v → v.val = interf (terms.val.drop from'.val) w.val ⦄ := by
  unfold rta.interference_exec
  simp only []
  split
  · have hlen : from'.val = terms.length := by simp_all
    simp [hlen, interf]
  · step as ⟨ t, ht ⟩
    step as ⟨ i1, hi1 ⟩
    · sc
    split
    · simp
    · step as ⟨ i2, hi2 ⟩
      · sc
      have hper : 0 < t.period.val := by
        apply hok; rw [ht]; exact List.getElem_mem _
      step with ceil_div_exec_spec i2 t.period hper as ⟨ o, ho ⟩
      cases o with
      | none => simp
      | some j =>
        simp only []
        have hj := ho j rfl
        step as ⟨ i3, hi3 ⟩
        step as ⟨ i4, hi4 ⟩
        have h3 : i3.val = j.val := by rw [hi3]; scalar_tac
        have h4 : i4.val = t.bound.val := by rw [hi4]; scalar_tac
        have hmul : j.val * t.bound.val ≤ 18446744073709551615 * 18446744073709551615 :=
          Nat.mul_le_mul (by sc) (by sc)
        step as ⟨ product, hprod ⟩
        step as ⟨ i5, hi5 ⟩
        have h5 : i5.val = (core.num.U64.MAX).val := by rw [hi5]; scalar_tac
        rw [MAX_val] at h5
        split
        · simp
        · step as ⟨ product1, hp1 ⟩
          have hp1v : product1.val = product.val := by rw [hp1]; sc
          step as ⟨ i6, hi6 ⟩
          have hlt : from'.val < terms.length := by scalar_tac
          step with interference_exec_spec terms i6 w hok (by scalar_tac) as ⟨ o1, ho1 ⟩
          cases o1 with
          | none => simp
          | some r =>
            simp only []
            have hr := ho1 r rfl
            step as ⟨ i7, hi7 ⟩
            split
            · simp
            · step as ⟨ i8, hi8 ⟩
              intro v hv
              simp at hv
              subst hv
              have hdrop : terms.val.drop from'.val = t :: terms.val.drop (from'.val + 1) := by
                rw [ht]; exact List.drop_eq_getElem_cons hlt
              rw [hdrop]
              simp only [interf]
              rw [hi8, hp1v, hprod, h3, h4, hj, hi2, hr, hi6]
termination_by terms.length - from'.val
decreasing_by scalar_decr_tac

theorem base_le_step (base : Nat) (ts : List rta.Term) (w : Nat) : base ≤ stepF base ts w := by
  unfold stepF; omega

theorem step_mono (base : Nat) (ts : List rta.Term) (w1 w2 : Nat) (h : w1 ≤ w2) :
    stepF base ts w1 ≤ stepF base ts w2 := by
  have := interf_mono ts w1 w2 h
  unfold stepF; omega

theorem below_fixpoint (base : Nat) (ts : List rta.Term) (w x : Nat) (hw : w ≤ x)
    (hx : stepF base ts x = x) : stepF base ts w ≤ x := by
  have := step_mono base ts w x hw
  omega

def post (base : Nat) (ts : List rta.Term) (jitter deadline : Nat) : rta.Outcome → Prop
  | .Fixpoint w => stepF base ts w.val = w.val ∧ (∀ x, stepF base ts x = x → w.val ≤ x)
      ∧ jitter + w.val ≤ deadline
  | .NotSchedulable w => deadline < jitter + w.val ∧ (∀ x, stepF base ts x = x → w.val ≤ x)
  | .Overflow => True

def inv (base : Nat) (ts : List rta.Term) (jitter deadline : Nat) (w : U64) : Prop :=
  base ≤ w.val ∧ w.val ≤ stepF base ts w.val ∧ (∀ x, stepF base ts x = x → w.val ≤ x)
    ∧ jitter + w.val ≤ deadline

theorem fixpoint_body_spec (base : U64) (terms : alloc.vec.Vec rta.Term) (jitter deadline w : U64)
    (hok : termsOk terms.val) (hinv : inv base.val terms.val jitter.val deadline.val w) :
    rta.fixpoint_loop.body base terms jitter deadline w ⦃ r =>
      match r with
      | .done y => post base.val terms.val jitter.val deadline.val y
      | .cont w' => inv base.val terms.val jitter.val deadline.val w'
          ∧ deadline.val - w'.val < deadline.val - w.val ⦄ := by
  unfold rta.fixpoint_loop.body
  obtain ⟨hb, hstep, hleast, hdl⟩ := hinv
  step with interference_exec_spec terms 0#usize w hok (by scalar_tac) as ⟨ o, ho ⟩
  cases o with
  | none => simp [post]
  | some i =>
    simp only []
    have hi := ho i rfl
    simp at hi
    step as ⟨ i1, hi1 ⟩
    · sc
    split
    · simp [post]
    · step as ⟨ next, hnext ⟩
      · sc
      have hns : next.val = stepF base.val terms.val w.val := by
        unfold stepF; rw [hnext, hi]
      split
      · -- The iterate is its own image: the least fixed point.
        rename_i heq
        have hw : next.val = w.val := by rw [heq]
        have hfix : stepF base.val terms.val w.val = w.val := by omega
        simp [post]
        exact ⟨hfix, hleast, hdl⟩
      · rename_i hne
        have hne' : next.val ≠ w.val := by
          intro h; exact hne (UScalar.eq_of_val_eq h)
        have hbelow : ∀ x, stepF base.val terms.val x = x → next.val ≤ x := by
          intro x hx
          rw [hns]
          exact below_fixpoint _ _ _ _ (hleast x hx) hx
        step as ⟨ i2, hi2 ⟩
        split
        · rename_i hgt
          have hlate : deadline.val < jitter.val + next.val := by sc
          simp [post]
          exact ⟨hlate, hbelow⟩
        · rename_i hle
          have h1 : base.val ≤ next.val := by rw [hns]; exact base_le_step _ _ _
          have h2 : next.val ≤ stepF base.val terms.val next.val := by
            have := step_mono base.val terms.val w.val next.val (by omega)
            omega
          have h3 : jitter.val + next.val ≤ deadline.val := by sc
          have h4 : deadline.val - next.val < deadline.val - w.val := by omega
          simp [inv]
          and_intros
          all_goals first | exact h1 | exact h2 | exact hbelow | exact h3 | exact h4

/-- Every fixed point is at least `base`. -/
theorem base_le_fixpoint (base : Nat) (ts : List rta.Term) (x : Nat)
    (hx : stepF base ts x = x) : base ≤ x := by
  have := base_le_step base ts x
  omega

/-- The response-time fixed point, on the code as compiled. For every
Task set whose periods are positive, `fixpoint` returns (it does not
panic, overflow, or loop for ever) and its result satisfies `post`. -/
theorem fixpoint_spec (base : U64) (terms : alloc.vec.Vec rta.Term) (jitter deadline : U64)
    (hok : termsOk terms.val) :
    rta.fixpoint base terms jitter deadline
      ⦃ r => post base.val terms.val jitter.val deadline.val r ⦄ := by
  unfold rta.fixpoint
  split
  · rename_i hgt
    have hlate : deadline.val < jitter.val + base.val := by scalar_tac
    simp [post]
    exact ⟨hlate, fun x hx => base_le_fixpoint _ _ _ hx⟩
  · step as ⟨ i, hi ⟩
    split
    · rename_i hgt
      have hlate : deadline.val < jitter.val + base.val := by scalar_tac
      simp [post]
      exact ⟨hlate, fun x hx => base_le_fixpoint _ _ _ hx⟩
    · rename_i hle
      unfold rta.fixpoint_loop
      apply loop.spec_decr_nat (fun (w : U64) => deadline.val - w.val)
        (inv base.val terms.val jitter.val deadline.val)
      · intro w hw
        apply WP.spec_mono (fixpoint_body_spec base terms jitter deadline w hok hw)
        intro r hr
        cases r <;> exact hr
      · simp only [inv]
        refine ⟨Nat.le_refl _, base_le_step _ _ _, fun x hx => base_le_fixpoint _ _ _ hx, ?_⟩
        scalar_tac

end rsk_analyzer
