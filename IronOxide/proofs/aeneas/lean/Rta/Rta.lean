def terms.endpoint_cost_add
  (acc : Std.U64) (ops : Std.U64) (p : terms.Params) :
  Result (Option Std.U64)
  := do
  let op ← if p.send >= p.recv
             then ok p.send
             else ok p.recv
  let o ← terms.mul ops op
  match o with
  | none => ok none
  | some c => terms.add acc c

