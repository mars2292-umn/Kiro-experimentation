        else
          let r ← w + i1.jitter
          ok ({ w, r, schedulable := false, overflow := false }, own_terms)
      | rta.Outcome.Overflow =>
        ok
          ({
             w := core.num.U64.MAX,
             r := core.num.U64.MAX,
             schedulable := false,
             overflow := true
